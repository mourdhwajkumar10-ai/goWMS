# goWMS runtime configuration (copy to .env and adjust).
# Used directly by the Go binary when run natively, and as defaults by
# docker-compose.yml when run in containers.

# --- Server ---
PORT=8080
JWT_SECRET=change-me-in-production
TOKEN_EXPIRY_HOURS=24

# --- Database (native run: point at your Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=gowms
DB_PASSWORD=secret
DB_NAME=gowms

# --- Optional (reserved; not yet used by the app) ---
REDIS_URL=localhost:6379

# --- docker-compose overrides ---
# APP_PORT is the host port for the web app in compose; DB_PORT is the host
# port for Postgres. In containers DB_HOST is forced to "postgres".
APP_PORT=8080
